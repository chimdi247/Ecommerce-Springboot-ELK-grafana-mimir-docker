    {
      "type": "gauge",
      "title": "Heap used % of max",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "100 * max(jvm_memory_used{job=\"ecommerce-backend\",jvm_memory_type=\"heap\"}) / max(jvm_memory_limit{job=\"ecommerce-backend\",jvm_memory_type=\"heap\"})",
          "legendFormat": "__auto",
          "editorMode": "code",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 70
              },
              {
                "color": "red",
                "value": 85
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showThresholdMarkers": true,
        "showThresholdLabels": false
      },
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 5
      }
