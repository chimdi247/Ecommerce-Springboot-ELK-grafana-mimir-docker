    {
      "type": "stat",
      "title": "Availability SLI",
      "description": "Share of requests that did not fail with 5xx.",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "100 * (1 - (sum(increase(http_server_request_duration_count{job=\"ecommerce-backend\",http_response_status_code=~\"5..\"}[$__range])) or vector(0)) / sum(increase(http_server_request_duration_count{job=\"ecommerce-backend\"}[$__range])))",
          "legendFormat": "__auto",
          "editorMode": "code",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
