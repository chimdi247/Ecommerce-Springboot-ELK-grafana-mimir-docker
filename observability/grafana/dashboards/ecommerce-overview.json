{
  "uid": "ecommerce-overview",
  "title": "Ecommerce - Overview (SLI / SLO / KPI)",
  "tags": [
    "ecommerce",
    "overview",
    "slo"
  ],
  "description": "Uptime, availability and latency SLOs, error budget, successful vs failed requests and business KPIs.",
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "type": "textbox",
        "name": "slo_availability",
        "label": "Availability SLO (%)",
        "query": "99.5",
        "current": {
          "selected": false,
          "text": "99.5",
          "value": "99.5"
        },
        "options": []
      },
      {
        "type": "custom",
        "name": "slo_latency",
        "label": "Latency SLO threshold (s)",
        "query": "0.1,0.25,0.5,1,2.5",
        "current": {
          "selected": true,
          "text": "0.5",
          "value": "0.5"
        },
        "options": [
          {
            "selected": false,
            "text": "0.1",
            "value": "0.1"
          },
          {
            "selected": false,
            "text": "0.25",
            "value": "0.25"
          },
          {
            "selected": true,
            "text": "0.5",
            "value": "0.5"
          },
          {
            "selected": false,
            "text": "1",
            "value": "1"
          },
          {
            "selected": false,
            "text": "2.5",
            "value": "2.5"
          }
        ],
        "multi": false,
        "includeAll": false
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "links": [
    {
      "title": "Ecommerce dashboards",
      "type": "dashboards",
      "tags": [
        "ecommerce"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true
    },
    {
      "title": "Kibana logs",
      "type": "link",
      "url": "http://localhost:5601/app/dashboards#/view/ecommerce-logs-overview",
      "icon": "doc",
      "targetBlank": true,
      "tooltip": "Structured logs (Elasticsearch / Kibana)"
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Service health & SLOs",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Services UP",
      "description": "Health probes: backend /actuator/health and the frontend.",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "100 * sum(probe_success{job=\"blackbox-http\"}) / count(probe_success{job=\"blackbox-http\"})",
          "legendFormat": "__auto",
          "editorMode": "code",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 99
              },
              {
                "color": "green",
                "value": 100
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Uptime (selected range)",
      "description": "Uptime SLI from synthetic probes.",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "100 * avg(avg_over_time(probe_success{job=\"blackbox-http\"}[$__range]))",
          "legendFormat": "__auto",
          "editorMode": "code",
          "instant": false,
          "range": true
