# =============================================================================
# Ecommerce stack configuration.   cp .env.example .env   then edit.
# .env is git-ignored. Never commit real keys.
# =============================================================================

# ---- REQUIRED: Stripe (https://dashboard.stripe.com/test/apikeys) ------------
# Use TEST keys (pk_test_... / sk_test_...). The publishable key is sent to the browser (safe);
# the secret key stays on the backend only.
STRIPE_PUBLISHABLE_KEY=stripe_api_public_key=pk_test_51NAuhqIQhXwfgNxDizUDoWLQTqkM11VuFk0pqP1IogJrq3D95dgZU2MvTDm1WgHcfZvSaj3FkQxVjSTKnvhxYjIV00aaoPbyv6
STRIPE_SECRET_KEY=sk_test_51NAuhqIQhXwfgNxD3kuw2JWjzbf7dfUAA5NRTK5p2wdSXWtz786uXnv8MTujvrAZ6D47E83hi2uFxfF4j0vTUW3Q00fYjXSKXV
STRIPE_CURRENCY=usd
# Optional. Payments work without it (the success page verifies the PaymentIntent with Stripe).
# To also receive webhooks:  stripe listen --forward-to localhost:2424/payment/webhook  -> whsec_...
STRIPE_WEBHOOK_SECRET=whsec_dd2759468e6db3f97e3dda35cc420b4869e5b42ac8cf8a153926d5018b6e29eb

# ---- REQUIRED for e-mails: Gmail SMTP -----------------------------------------
# Google Account -> Security -> 2-Step Verification (on) -> App passwords -> create one (16 chars).
# Use the APP PASSWORD here, not your normal Gmail password. Used for BOTH the payment
# confirmation e-mails and Grafana alert e-mails.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=chimdi247@gmail.com
SMTP_PASSWORD=dzvjhzclrgkxtuiy
SMTP_AUTH=true
SMTP_STARTTLS=true
MAIL_FROM=chimdi247@gmail.com
MAIL_BRAND_NAME=Phegon Mart
MAIL_SUPPORT_EMAIL=chimdi247@gmail.com
FRONTEND_URL=http://136.65.129.38:3000
# Who receives Grafana alerts (CPU / memory > 40% ...)
ALERT_EMAIL_TO=shimdi247@gmail.com

# ---- Application -----------------------------------------------------------------
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_DATABASE=eshop_spring
MYSQL_EXPORTER_PASSWORD=exporter_password

# 32+ characters. Generate:  openssl rand -base64 48
JWT_SECRET=qwertyuioasdfghjklqwertyuiosdfghjklqwertyuiopasdfghjklqwertyuioasdfghj
# Creates admin@example.com / password123 (+ customer@example.com) and 12 demo products on first start.
# Set to false in any real environment.
APP_SEED_ENABLED=true

# Optional product image upload to AWS S3 (admin "add product"). Not needed for the seeded demo catalog.
AWS_S3_ACCESS_KEY=minioadmin
AWS_S3_SECRET_KEY=minioadmin
AWS_S3_BUCKET=phegon-eshop
AWS_S3_REGION=eu-west-2

# ---- Caching & rate limiting --------------------------------------------------------
PRODUCT_CACHE_TTL_SECONDS=600
RATE_LIMIT_ENABLED=true
# GET /product/get-all: max requests per client IP per window (raise for load tests, e.g. 100000)
RATE_LIMIT_GET_ALL_PER_WINDOW=30
RATE_LIMIT_WINDOW_SECONDS=60

# ---- Ports --------------------------------------------------------------------------
FRONTEND_PORT=3000
BACKEND_PORT=2424
GRAFANA_PORT=3001
KIBANA_PORT=5601

# ---- Observability -------------------------------------------------------------------
DEPLOYMENT_ENVIRONMENT=local
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
# Mimir stores metric blocks in an S3 bucket. Defaults = bundled MinIO (console: http://localhost:9001).
# For AWS S3 see observability/README.md.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_ENDPOINT=minio:9000
S3_REGION=us-east-1
S3_INSECURE=true
MIMIR_BLOCKS_BUCKET=mimir-blocks
MIMIR_RULER_BUCKET=mimir-ruler
MIMIR_ALERTMANAGER_BUCKET=mimir-alertmanager
